{
  "name": "@kreeger/pi-subagent-teams",
  "version": "0.1.0",
  "description": "Session-scoped model presets for Pi subagent teams",
  "license": "MIT",
  "author": "Ben Kreeger",
  "keywords": [
    "pi-package",
    "pi",
    "subagents",
    "models",
    "teams"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kreeger/pi-subagent-teams.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src/*.ts",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "release": "release-it"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/node": "^25.6.0",
    "prettier": "^3.0.0",
    "release-it": "^21.0.2",
    "typescript": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
